{
  "manifest_version": 3,
  "name": "Agent Usage Desk",
  "version": "0.3.2",
  "description": "Agent Usage Desk：Codex、WorkBuddy 桌面端与 CodeBuddy CLI 的本机用量、缓存与每日统计；每分钟自动刷新，可调整间隔。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "打开 Agent Usage Desk",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
